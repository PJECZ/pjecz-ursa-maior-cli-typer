# Base de datos
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
SQLALCHEMY_DATABASE_URI="postgresql+psycopg2://DB_USER:DB_PASS@DB_HOST:DB_PORT/DB_NAME"

# LIMIT y TIMEOUT por defecto
LIMIT=20
TIMEOUT=30

# Salt sirve para cifrar el ID con HashID
SALT=

# Huso horario
TZ=America/Mexico_City
